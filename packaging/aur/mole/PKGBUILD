# Maintainer: Lajos Deme <l@deme.ventures>
#
# Source package. The binary package (mole-bin) is generated and pushed by
# GoReleaser on release with checksums computed from the artifacts themselves;
# this one is maintained by hand, because a source build has nothing to verify
# against but the tag.
#
# To bump: edit pkgver, run `updpkgsums`, then `makepkg --printsrcinfo > .SRCINFO`.
pkgname=mole
pkgver=0.1.0
pkgrel=1
pkgdesc="Deep-research agent with an enforced budget and verified quotes"
arch=('x86_64' 'aarch64')
url="https://github.com/lajosdeme/mole"
license=('Apache-2.0')
depends=()
makedepends=('go>=1.25')
provides=('mole')
conflicts=('mole-bin')
source=("$pkgname-$pkgver.tar.gz::https://github.com/lajosdeme/mole/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  # CGO off is not a preference: the pure-Go SQLite driver is what makes mole one
  # static binary with no libc to match, which the README promises.
  export CGO_ENABLED=0
  export GOFLAGS="-trimpath -mod=readonly -modcacherw"
  local ldflags="-s -w -X main.version=v$pkgver"
  go build -ldflags "$ldflags" -o build/mole ./cmd/mole
  go build -ldflags "$ldflags" -o build/mole-mcp ./cmd/mole-mcp
}

check() {
  cd "$pkgname-$pkgver"
  # The suite is the reason to trust the binary. A package that skips it ships
  # something nobody verified.
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/mole "$pkgdir/usr/bin/mole"
  install -Dm755 build/mole-mcp "$pkgdir/usr/bin/mole-mcp"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
